### Register a new user
POST http://localhost:4000/api/auth/register
Content-Type: application/json

{
  "email": "JakubTTT@example.com",
  "password": "password123",
  "firstName": "Marcin",
  "lastName": "Dudek"
}
### Register a new user
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
  "email": "test@testowy.pl",
  "password": "123456"
}

### Get user data (requires authentication)
# Replace the token below with a valid token received from login or register
GET http://localhost:4000/api/auth/me
Authorization: Bearer eyJhbGciOiJkaXIiLCJlbmMiOiJBMjU2R0NNIn0..lPQKxngXlWWDdaTj.LNGNjGLswlPxQ68W6q7sHL8BuN8BMzhWEZBHVz4JiuJ_wN-LBCwiDyZ3ZBjSYkQ7ICDTYO0tdbsH-PbU0VJB13D1rxo8tXYH2fiPmzad23q1Tea27YgXlFeULrbRt3LD9xGs493DZXrY24XdDN1oN_CB_dnTEXt7Q1ykjWMx1pCS4Z8.6cyx672l3zwlqQLk7_E_jw
