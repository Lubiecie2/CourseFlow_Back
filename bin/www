#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require("../app");
var debug = require("debug")("courseflow-backend:server");
var http = require("http");
var server = http.createServer(app);

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || "4000");
app.set("port", port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on("error", onError);
server.on("listening", onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== "listen") {
    throw error;
  }

  var bind = typeof port === "string" ? "Pipe " + port : "Port " + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case "EACCES":
      console.error(bind + " requires elevated privileges");
      process.exit(1);
      break;
    case "EADDRINUSE":
      console.error(bind + " is already in use");
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === "string" ? "pipe " + addr : "port " + addr.port;
  debug("Listening on " + bind);

  // Uruchom scheduler partycji
  const partitionService = require("../services/partitionService");
  partitionService.startScheduler();
}

// Dodaj obsługę zatrzymania serwera
process.on("SIGINT", () => {
  console.log("Zatrzymywanie aplikacji...");

  // Zatrzymaj scheduler partycji
  const partitionService = require("../services/partitionService");
  partitionService.stopScheduler();

  process.exit(0);
});

const io = require("socket.io")(server, {
  cors: {
    origin: "http://localhost:3000",
    methods: ["GET", "POST"],
    credentials: true,
  },
});

io.on("connection", (socket) => {
  console.log("Nowy klient połączony:", socket.id);

  socket.on("join-question", (questionId) => {
    socket.join(`question-${questionId}`);
    console.log(`Klient ${socket.id} dołączył do pytania ${questionId}`);
  });

  socket.on("leave-question", (questionId) => {
    socket.leave(`question-${questionId}`);
    console.log(`Klient ${socket.id} opuścił pytanie ${questionId}`);
  });

  socket.on("join-questions-list", () => {
    socket.join("questions-list");
    console.log(`Klient ${socket.id} dołączył do listy pytań`);
  });

  socket.on("leave-questions-list", () => {
    socket.leave("questions-list");
    console.log(`Klient ${socket.id} opuścił listę pytań`);
  });

  socket.on("disconnect", () => {
    console.log("Klient rozłączony:", socket.id);
  });

  socket.on("question-edited", (updatedQuestion) => {
    io.to(`question-${updatedQuestion.id}`).emit(
      "question-updated",
      updatedQuestion
    );
    io.to("questions-list").emit("question-updated", updatedQuestion);
    console.log(
      `Klient ${socket.id} zaktualizował treść pytania ${updatedQuestion.id}`
    );
  });

  socket.on("question-deleted", (questionId) => {
    io.to(`question-${questionId}`).emit("question-removed", questionId);
    io.to("questions-list").emit("question-removed", questionId);
    console.log(`Klient ${socket.id} usunął pytanie ${questionId}`);
  });

  socket.on("answer-edited", (updatedAnswer) => {
    socket
      .to(`question-${updatedAnswer.question_id}`)
      .emit("answer-updated", updatedAnswer);
    console.log(
      `Klient ${socket.id} zaktualizowal treśc odpowiedzi ${updatedAnswer.id}`
    );
  });

  socket.on("answer-deleted", (data) => {
    io.to(`question-${data.questionId}`).emit("answer-removed", data.answerId);
    console.log(`Klient ${socket.id} usunął odpowiedź ${data.answerId}`);
  });
});

app.set("io", io);
